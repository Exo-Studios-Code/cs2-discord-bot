# ══════════════════════════════════════════════════════════════
#   CS2 Discord Bot — Konfigurace (.env)
#   Zkopiruj jako ".env" a vyplň hodnoty
# ══════════════════════════════════════════════════════════════

# ── POVINNE ──────────────────────────────────────────────────

# Discord Bot Token
# https://discord.com/developers/applications
DISCORD_TOKEN=tvuj_discord_bot_token

# Steam Web API Key
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=tvuj_steam_api_klic

# ── DOPORUCENE ────────────────────────────────────────────────

# Google AI (Gemini 2.0 Flash) — ZDARMA
# https://aistudio.google.com/app/apikey
GOOGLE_AI_KEY=tvuj_gemini_klic

# Leetify API Key — ZDARMA (bez klice funguje ale s limity)
# https://leetify.com/app/developer
LEETIFY_API_KEY=tvuj_leetify_klic

# FACEIT API Key — ZDARMA (bez klice FACEIT nefunguje)
# https://developers.faceit.com → Apps → API Keys
FACEIT_API_KEY=tvuj_faceit_klic
